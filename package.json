{
  "name": "quietchat",
  "version": "0.2.11",
  "private": true,
  "description": "Native GTK4 WhatsApp companion with a lightweight terminal option",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/src/main.js",
    "demo": "npm start -- --demo",
    "test": "npm run build && node --disable-warning=ExperimentalWarning dist/test/core.test.js",
    "test:terminal": "npm run build && python3 scripts/smoke.py",
    "check": "tsc --noEmit",
    "benchmark": "npm run build && node --disable-warning=ExperimentalWarning dist/scripts/benchmark.js",
    "probe": "npm run build && node --disable-warning=ExperimentalWarning dist/scripts/probe.js",
    "test:native": "npm run build && GDK_BACKEND=x11 xvfb-run -a -s '-screen 0 1400x1000x24' dbus-run-session -- /usr/bin/python3 scripts/native-smoke.py"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "neo-blessed": "0.2.0",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@types/blessed": "0.1.27",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/quiet-desktop-apps/QuietChat.git"
  }
}
